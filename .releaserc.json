{
  "branches": [
    "main"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "npm run build:npm",
        "publishCmd": "mvn --batch-mode --no-transfer-progress deploy -Drevision=${nextRelease.version} && npm pack --prefix packages/backend-core-api-v0"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "pkgRoot": "packages/backend-core-api-v0",
        "npmPublish": true
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "neuland-ingolstadt-backend-core-api-v0-*.tgz",
            "label": "NPM package tarball (install without GitHub auth)"
          }
        ]
      }
    ]
  ]
}
